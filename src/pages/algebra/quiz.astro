    let katexLoadPromise = null;
    function ensureKatex() {
      if (window.katex) return Promise.resolve(window.katex);
      if (katexLoadPromise) return katexLoadPromise;

      katexLoadPromise = (async () => {
        // Ensure stylesheet is present if primary CDN was blocked
        if (!document.getElementById("katex-css-fallback")) {
          const link = document.createElement("link");
          link.id = "katex-css-fallback";
          link.rel = "stylesheet";
          link.href = "https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.css";
          document.head.appendChild(link);
        }
        try {
          const mod = await import("https://esm.sh/katex@0.16.11");
          window.katex = mod.default || mod;
        } catch (_) {
          // Keep graceful text fallback if completely offline
        }
        if (window.katex) {
          document.querySelectorAll("[data-tex]").forEach(node => {
            const tex = node.dataset.tex;
            const dm = node.dataset.display === "true";
            if (tex) {
              try {
                window.katex.render(tex, node, { displayMode: dm, throwOnError: false });
              } catch (_) {}
            }
          });
        }
        return window.katex;
      })();

      return katexLoadPromise;
    }

    function renderKatex(el, tex, displayMode = true) {
      el.dataset.tex = tex;
      el.dataset.display = displayMode ? "true" : "false";
      if (window.katex) {
        try {
          window.katex.render(tex, el, { displayMode, throwOnError: false });
          return;
        } catch (_) {}
      }
      el.textContent = tex;
      ensureKatex();
    }

    function applyThemeAndKeypad() {
      const isDark = state.settings.theme === "dark";
      document.documentElement.classList.toggle("dark", isDark);
      els.mobileKeypad.classList.toggle("hidden", !state.settings.showKeypad);
      document.getElementById("icon-sound-on").classList.toggle("hidden", !state.settings.sound);
      document.getElementById("icon-sound-off").classList.toggle("hidden", state.settings.sound);
    }

    function popDelta(text, positive) {
      els.hudDeltaPop.textContent = text;
      els.hudDeltaPop.className = `font-mono text-xs font-bold pointer-events-none animate-delta ${
        positive ? "text-emerald-500" : "text-rose-500"
      }`;
      void els.hudDeltaPop.offsetWidth;
    }

    function updateHUD() {
      if (state.mode === "sprint" || state.mode === "timedelta") {
        els.hudTimerLabel.textContent = "Time Left";
        els.hudTimer.textContent = `${Math.max(0, state.timeLeft).toFixed(1)}s`;
        els.hudTimer.classList.toggle("text-rose-500", state.timeLeft <= 10 && state.status === "running");
        els.hudTimer.classList.toggle("text-sky-600", !(state.timeLeft <= 10 && state.status === "running"));
        els.hudTimer.classList.toggle("dark:text-sky-400", !(state.timeLeft <= 10 && state.status === "running"));
      } else {
        els.hudTimerLabel.textContent = state.mode === "pipeline" ? "Chains Done" : "Elapsed";
        els.hudTimer.textContent = state.mode === "pipeline"
          ? `${state.pipelinesCompleted}`
          : `${state.elapsed.toFixed(1)}s`;
      }

      els.hudSolved.textContent = `${state.solved}`;
      const mins = Math.max(state.elapsed / 60, 1 / 60);
      const spm = state.status === "ready" ? 0 : state.solved / mins;
      els.hudSpm.textContent = `${spm.toFixed(1)}/m`;

      els.hudStreak.textContent = `${state.streak}`;
      const mult = 1 + Math.floor(state.streak / 5) * 0.5;
      els.hudMult.textContent = `${mult.toFixed(1)}×`;

      const acc = state.attempts === 0 ? 100 : Math.round((state.solved / state.attempts) * 100);
      els.hudAccuracy.textContent = `${acc}%`;
    }

    function setFeedback(text, tone = "neutral") {
      els.feedbackBanner.textContent = text;
      els.feedbackBanner.className = "font-semibold shrink-0 " + (
        tone === "success" ? "text-emerald-600 dark:text-emerald-400" :
        tone === "error" ? "text-rose-600 dark:text-rose-400" :
        tone === "warn" ? "text-amber-600 dark:text-amber-400" :
        "text-slate-500 dark:text-slate-400"
      );
    }

    function updateLiveAstPreview(rawVal) {
      const trimmed = (rawVal || "").trim();
      if (!trimmed) {
        els.liveAstPreview.textContent = "Waiting for input...";
        return;
      }
      try {
        const res = nanoParseAndSimplify(trimmed);
        if (nanoReady && res.simplifiedTree) {
          const tex = treeToLatex(res.simplifiedTree);
          els.liveAstPreview.innerHTML = "";
          const span = document.createElement("span");
          renderKatex(span, tex, false);
          els.liveAstPreview.appendChild(span);
        } else {
          els.liveAstPreview.textContent = res.printed;
        }
      } catch (err) {
        els.liveAstPreview.innerHTML = `<span class="text-amber-500">${err.message || "Syntax incomplete..."}</span>`;
      }
    }

    // =========================================================================
    // 6. GAME FLOW, MODE SWITCHING & QUESTION LOADING
    // =========================================================================
    function stopTimer() {
      if (state.timerHandle) {
        clearInterval(state.timerHandle);
        state.timerHandle = null;
      }
    }

    function getDeltaConfig() {
      const [gainStr, lossStr] = state.settings.deltaRule.split(",");
      const gain = Number(gainStr) || 4;
      const loss = Math.abs(Number(lossStr)) || 8;
      const start = gain === 5 ? 60 : (gain === 3 ? 30 : 45);
      return { gain, loss, start };
    }

    function selectMode(mode) {
      stopTimer();
      state.mode = mode;

      els.modeBtns.forEach(btn => {
        const active = btn.dataset.mode === mode;
        btn.className = active
          ? "mode-btn flex flex-col items-start sm:items-center justify-center px-3 py-2.5 rounded-xl text-left sm:text-center transition font-medium bg-slate-900 text-white dark:bg-sky-500 dark:text-slate-950 shadow-sm"
          : "mode-btn flex flex-col items-start sm:items-center justify-center px-3 py-2.5 rounded-xl text-left sm:text-center transition font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/70";
      });

      state.solved = 0;
      state.attempts = 0;
      state.streak = 0;
      state.bestStreak = 0;
      state.elapsed = 0;
      state.topicStats = {};
      state.pipelineStage = 1;
      state.pipelineCarry = null;
      state.pipelinesCompleted = 0;

      if (mode === "zen") {
        startRun();
        return;
      }

      state.status = "ready";
      els.startOverlay.classList.remove("hidden");
      els.summaryOverlay.classList.add("hidden");
      els.questionWorkspace.classList.add("hidden");

      const activeCount = state.settings.enabledTopics.length;
      els.readyPresetLabel.textContent = `${state.settings.difficulty.toUpperCase()} • ${activeCount} Module${activeCount === 1 ? "" : "s"} Active`;

      if (mode === "sprint") {
        state.timeLeft = Number(state.settings.sprintSec) || 90;
        els.readyModeTitle.textContent = `Timed Sprint (${state.timeLeft}s)`;
        els.readyModeDesc.textContent = "Continuous rapid-fire arithmetic and Year 13 algebra. Maximize your solves per minute before the clock hits zero.";
      } else if (mode === "timedelta") {
        const d = getDeltaConfig();
        state.timeLeft = d.start;
        els.readyModeTitle.textContent = `Time-Delta Survival (${d.start}s)`;
        els.readyModeDesc.textContent = `Start with ${d.start}s. Each exact solve awards +${d.gain}s; every mistake costs -${d.loss}s. Balance raw speed with exam accuracy.`;
      } else if (mode === "pipeline") {
        state.timeLeft = 0;
        els.readyModeTitle.textContent = "Chained Exam Pipeline";
        els.readyModeDesc.textContent = "Solve 3-stage connected Year 13 problems where the exact output of Stage 1 feeds directly into Stage 2, and Stage 2 into Stage 3.";
      }

      const pb = state.bests[`${mode}_${state.settings.difficulty}`];
      els.readyPbBadge.textContent = pb ? `Personal Best (${state.settings.difficulty}): ${pb}` : "Personal Best: No runs recorded yet";
      updateHUD();
    }

    function updatePipelineUI() {
      if (state.mode !== "pipeline") {
        els.pipelineTracker.classList.add("hidden");
        els.pipelineTracker.classList.remove("flex");
        return;
      }
      els.pipelineTracker.classList.remove("hidden");
      els.pipelineTracker.classList.add("flex");

      const stepEls = [els.pipeStep1, els.pipeStep2, els.pipeStep3];
      stepEls.forEach((el, idx) => {
        const s = idx + 1;
        if (s < state.pipelineStage) {
          el.className = "px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-emerald-500 text-white";
        } else if (s === state.pipelineStage) {
          el.className = "px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-sky-500 text-white";
        } else {
          el.className = "px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-slate-200 dark:bg-slate-700 text-slate-500";
        }
      });

      if (state.pipelineStage > 1 && state.pipelineCarry !== null) {
        els.pipeCarryBadge.classList.remove("hidden");
        els.pipeCarryBadge.textContent = `Carry: ${state.pipelineCarry}`;
      } else {
        els.pipeCarryBadge.classList.add("hidden");
      }
    }

    function nextQuestion() {
      const pool = state.settings.enabledTopics.length > 0
        ? state.settings.enabledTopics
        : TOPICS.map(t => t.id);
      const topicId = pick(pool);
      const carry = state.mode === "pipeline" && state.pipelineStage > 1 ? state.pipelineCarry : null;

      const q = generateProblem(topicId, state.settings.difficulty, carry);
      state.currentQ = q;
      state.qStartTime = performance.now();

      els.qTierBadge.textContent = q.tier;
      els.qTopicBadge.textContent = q.topicName;
      els.qStepTimer.textContent = "0.0s";
      els.qInstruction.textContent = q.instruction;
      els.qFormatHint.textContent = q.formatHint;
      renderKatex(els.qMathDisplay, q.latex, true);

      updatePipelineUI();

      // Hide worked solution box
      els.solutionBox.classList.add("hidden");
      els.solutionContent.innerHTML = "";

      // Toggle appropriate slot inputs
      els.inputSingleWrap.classList.add("hidden");
      els.inputPairWrap.classList.add("hidden");
      els.inputMatrixWrap.classList.add("hidden");

      if (q.inputType === "pair") {
        els.inputPairWrap.classList.remove("hidden");
        els.pairLabel1.textContent = q.pairLabels?.[0] || "1 =";
        els.pairLabel2.textContent = q.pairLabels?.[1] || "2 =";
        els.ansPair1.value = "";
        els.ansPair2.value = "";
        state.activeSlotEl = els.ansPair1;
        setTimeout(() => els.ansPair1.focus(), 10);
      } else if (q.inputType === "matrix") {
        els.inputMatrixWrap.classList.remove("hidden");
        els.matSlots.forEach(s => { s.value = ""; });
        state.activeSlotEl = els.matSlots[0];
        setTimeout(() => els.matSlots[0].focus(), 10);
      } else {
        els.inputSingleWrap.classList.remove("hidden");
        els.ansSingle.value = "";
        state.activeSlotEl = els.ansSingle;
        setTimeout(() => els.ansSingle.focus(), 10);
      }

      els.liveAstPreview.textContent = "Waiting for input...";
      setFeedback("Press Enter to submit", "neutral");
    }

    function submitAnswer() {
      if (state.status !== "running" || !state.currentQ) return;
      const q = state.currentQ;

      let userInputs = [];
      if (q.inputType === "pair") {
        userInputs = [els.ansPair1.value.trim(), els.ansPair2.value.trim()];
      } else if (q.inputType === "matrix") {
        userInputs = els.matSlots.map(s => s.value.trim());
      } else {
        userInputs = [els.ansSingle.value.trim()];
      }

      if (userInputs.some(v => !v)) {
        setFeedback("Fill in all answer slots first.", "warn");
        return;
      }

      // Validate syntax & mathematical equivalence via nanoalgebra
      let allValid = true;
      let diagnosticMsg = null;

      try {
        if (q.inputType === "single") {
          const res = verifyExpression(userInputs[0], q.answer, {
            requireRationalised: Boolean(q.requireRationalised)
          });
          allValid = res.ok;
          diagnosticMsg = res.diagnostic;
        } else {
          for (let i = 0; i < q.answer.length; i++) {
            const res = verifyExpression(userInputs[i], q.answer[i]);
            if (!res.ok) {
              allValid = false;
              diagnosticMsg = res.diagnostic;
              break;
            }
          }
        }
      } catch (err) {
        setFeedback(`Syntax error: ${err.message}`, "warn");
        return;
      }

      // Record telemetry
      const solveMs = Math.max(100, performance.now() - state.qStartTime);
      if (!state.topicStats[q.topicId]) {
        state.topicStats[q.topicId] = { solved: 0, attempts: 0, totalMs: 0 };
      }
      state.attempts += 1;
      state.topicStats[q.topicId].attempts += 1;

      if (allValid) {
        state.solved += 1;
        state.streak += 1;
        state.bestStreak = Math.max(state.bestStreak, state.streak);
        state.topicStats[q.topicId].solved += 1;
        state.topicStats[q.topicId].totalMs += solveMs;

        playTone("hit");

        if (state.mode === "timedelta") {
          const { gain } = getDeltaConfig();
          state.timeLeft += gain;
          popDelta(`+${gain}s`, true);
        }

        if (state.mode === "pipeline") {
          if (state.pipelineStage < 3) {
            state.pipelineStage += 1;
            state.pipelineCarry = q.numericCarry;
            setFeedback(`Stage ${state.pipelineStage - 1} cleared! Carrying ${q.numericCarry} → Stage ${state.pipelineStage}`, "success");
          } else {
            state.pipelinesCompleted += 1;
            state.pipelineStage = 1;
            state.pipelineCarry = null;
            setFeedback(`Chain #${state.pipelinesCompleted} Complete!`, "success");
          }
        } else {
          setFeedback(`Exact! (${(solveMs / 1000).toFixed(1)}s)`, "success");
        }

        updateHUD();

        if (state.settings.autoAdvance) {
          setTimeout(() => {
            if (state.status === "running") nextQuestion();
          }, 140);
        } else {
          renderKatex(els.solutionContent, q.solutionLatex, true);
          els.solutionBox.classList.remove("hidden");
        }
      } else {
        state.streak = 0;
        playTone("miss");

        els.drillCard.classList.remove("animate-shake");
        void els.drillCard.offsetWidth;
        els.drillCard.classList.add("animate-shake");

        if (state.mode === "timedelta") {
          const { loss } = getDeltaConfig();
          state.timeLeft = Math.max(0, state.timeLeft - loss);
          popDelta(`-${loss}s`, false);
        }

        const trapHit = typeof q.checkTrap === "function" ? q.checkTrap(userInputs) : null;
        setFeedback(trapHit || diagnosticMsg || "Incorrect — check signs or click Method / Hint.", "error");
        updateHUD();
      }
    }

    function startRun() {
      stopTimer();
      state.status = "running";
      state.solved = 0;
      state.attempts = 0;
      state.streak = 0;
      state.bestStreak = 0;
      state.elapsed = 0;
      state.topicStats = {};
      state.pipelineStage = 1;
      state.pipelineCarry = null;
      state.pipelinesCompleted = 0;

      if (state.mode === "sprint") {
        state.timeLeft = Number(state.settings.sprintSec) || 90;
      } else if (state.mode === "timedelta") {
        state.timeLeft = getDeltaConfig().start;
      }

      els.startOverlay.classList.add("hidden");
      els.summaryOverlay.classList.add("hidden");
      els.questionWorkspace.classList.remove("hidden");

      nextQuestion();

      const tickMs = 100;
      state.timerHandle = setInterval(() => {
        if (state.status !== "running") return;
        state.elapsed += 0.1;

        if (state.qStartTime) {
          const qSec = (performance.now() - state.qStartTime) / 1000;
          els.qStepTimer.textContent = `${qSec.toFixed(1)}s`;
        }

        if (state.mode === "sprint" || state.mode === "timedelta") {
          state.timeLeft -= 0.1;
          if (state.timeLeft <= 0) {
            state.timeLeft = 0;
            updateHUD();
            finishRun();
            return;
          }
        }
        updateHUD();
      }, tickMs);

      updateHUD();
    }

    function finishRun() {
      stopTimer();
      state.status = "summary";
      playTone("complete");

      els.questionWorkspace.classList.add("hidden");
      els.startOverlay.classList.add("hidden");
      els.summaryOverlay.classList.remove("hidden");

      const mins = Math.max(state.elapsed / 60, 1 / 60);
      const spm = (state.solved / mins).toFixed(1);
      const acc = state.attempts === 0 ? 100 : Math.round((state.solved / state.attempts) * 100);

      document.getElementById("summary-title").textContent =
        state.mode === "sprint" ? "Timed Sprint Debrief" :
        state.mode === "timedelta" ? "Time-Delta Survival Debrief" :
        state.mode === "pipeline" ? "Chain Pipeline Summary" : "Zen Practice Summary";

      const subtitleParts = [`Time spent: ${state.elapsed.toFixed(1)}s`, `Difficulty: ${state.settings.difficulty}`];
      if (state.mode === "pipeline") {
        subtitleParts.unshift(`Chains completed: ${state.pipelinesCompleted}`);
      }
      document.getElementById("summary-subtitle").textContent = subtitleParts.join(" • ");

      document.getElementById("sum-solved").textContent = `${state.solved}`;
      document.getElementById("sum-spm").textContent = `${spm}`;
      document.getElementById("sum-acc").textContent = `${acc}%`;
      document.getElementById("sum-streak").textContent = `${state.bestStreak}`;

      // Save Personal Best for timed modes
      if (state.solved > 0 && (state.mode === "sprint" || state.mode === "timedelta")) {
        const key = `${state.mode}_${state.settings.difficulty}`;
        const prev = state.bests[key];
        const metricLabel = `${state.solved} solved (${spm} SPM)`;
        if (!prev || state.solved >= parseInt(prev, 10)) {
          state.bests[key] = metricLabel;
          persistData();
        }
      }

      // Render Topic Telemetry & identify slowest/weakest topic
      const listEl = document.getElementById("sum-topic-list");
      listEl.innerHTML = "";
      let weakestTopicId = null;
      let worstScore = -1;

      const topicEntries = Object.entries(state.topicStats);
      if (topicEntries.length === 0) {
        listEl.innerHTML = `<div class="col-span-full p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200/70 dark:border-slate-800 text-xs text-slate-400 text-center">No questions attempted yet — solve a few drills to unlock per-topic speed & accuracy telemetry.</div>`;
      }

      topicEntries.forEach(([tid, st]) => {
        const meta = TOPICS.find(t => t.id === tid) || { name: tid, tier: "" };
        const tAcc = st.attempts === 0 ? 100 : Math.round((st.solved / st.attempts) * 100);
        const avgSec = st.solved > 0 ? (st.totalMs / st.solved / 1000).toFixed(1) : "—";
        const weaknessMetric = (100 - tAcc) * 10 + (st.solved > 0 ? st.totalMs / st.solved / 1000 : 30);

        if (weaknessMetric > worstScore) {
          worstScore = weaknessMetric;
          weakestTopicId = tid;
        }

        const card = document.createElement("div");
        card.className = "p-3 rounded-xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200/70 dark:border-slate-800 flex items-center justify-between gap-2";
        card.innerHTML = `
          <div class="min-w-0">
            <div class="text-xs font-bold truncate">${meta.name}</div>
            <div class="text-[11px] text-slate-400">${st.solved}/${st.attempts} hit • avg ${avgSec}s</div>
          </div>
          <span class="font-mono text-xs font-bold px-2 py-1 rounded-lg ${
            tAcc >= 80 ? "bg-emerald-500/10 text-emerald-500" : "bg-amber-500/10 text-amber-500"
          }">${tAcc}%</span>
        `;
        listEl.appendChild(card);
      });

      const weakBtn = document.getElementById("btn-drill-weakest");
      if (weakestTopicId && topicEntries.length > 1) {
        weakBtn.classList.remove("hidden");
        weakBtn.dataset.topicId = weakestTopicId;
        const meta = TOPICS.find(t => t.id === weakestTopicId);
        weakBtn.textContent = `Drill Weakest (${meta ? meta.name : weakestTopicId})`;
      } else {
        weakBtn.classList.add("hidden");
      }
    }

    // =========================================================================
    // 7. SETTINGS MODAL & EVENT LISTENERS
    // =========================================================================
    function renderTopicToggles() {
      els.topicTogglesGrid.innerHTML = "";
      TOPICS.forEach(t => {
        const checked = state.settings.enabledTopics.includes(t.id);
        const label = document.createElement("label");
        label.className = "flex items-start gap-2.5 p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-950/50 cursor-pointer hover:border-sky-500/50 transition";
        label.innerHTML = `
          <input type="checkbox" value="${t.id}" ${checked ? "checked" : ""} class="topic-chk mt-0.5 w-4 h-4 rounded accent-sky-500" />
          <div class="min-w-0">
            <div class="text-xs font-bold flex items-center gap-1.5">
              <span class="truncate">${t.name}</span>
              <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-slate-200/70 dark:bg-slate-800 text-slate-500">${t.tier}</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-snug mt-0.5">${t.desc}</p>
          </div>
        `;
        els.topicTogglesGrid.appendChild(label);
      });

      const updateCountLabel = () => {
        const count = els.topicTogglesGrid.querySelectorAll(".topic-chk:checked").length;
        els.activeTopicCount.textContent = `${count} / ${TOPICS.length} enabled`;
      };
      els.topicTogglesGrid.querySelectorAll(".topic-chk").forEach(chk => {
        chk.addEventListener("change", updateCountLabel);
      });
      updateCountLabel();
    }

    function openSettingsModal() {
      renderTopicToggles();
      els.cfgDifficulty.value = state.settings.difficulty;
      els.cfgSprintSec.value = String(state.settings.sprintSec);
      els.cfgDeltaRule.value = state.settings.deltaRule;
      els.cfgShowKeypad.checked = state.settings.showKeypad;
      els.cfgAutoAdvance.checked = state.settings.autoAdvance;
      els.settingsModal.classList.remove("hidden");
    }

    function closeSettingsModal() {
      els.settingsModal.classList.add("hidden");
    }

    // Mode toggle buttons
    els.modeBtns.forEach(btn => {
      btn.addEventListener("click", () => selectMode(btn.dataset.mode));
    });

    // Start, Restart & Weakest-topic buttons
    document.getElementById("btn-start-run").addEventListener("click", startRun);
    document.getElementById("btn-restart-run").addEventListener("click", () => {
      if (state.mode === "zen") startRun();
      else selectMode(state.mode);
    });
    document.getElementById("btn-drill-weakest").addEventListener("click", (e) => {
      const tid = e.currentTarget.dataset.topicId;
      if (tid) {
        state.settings.enabledTopics = [tid];
        persistData();
      }
      selectMode("zen");
    });

    // Submit, Method/Hint, Skip, and Finish controls
    document.getElementById("btn-submit-answer").addEventListener("click", submitAnswer);

    document.getElementById("btn-show-solution").addEventListener("click", () => {
      if (!state.currentQ) return;
      renderKatex(els.solutionContent, state.currentQ.solutionLatex, true);
      els.solutionBox.classList.toggle("hidden");
    });

    document.getElementById("btn-skip-question").addEventListener("click", () => {
      if (state.status !== "running") return;
      state.streak = 0;
      if (state.mode === "pipeline") {
        state.pipelineStage = 1;
        state.pipelineCarry = null;
      }
      updateHUD();
      nextQuestion();
    });

    document.getElementById("btn-finish-session").addEventListener("click", () => {
      if (state.status !== "running") return;
      finishRun();
    });

    // Track focused input slot & live nanoalgebra AST preview
    document.querySelectorAll(".math-slot").forEach(input => {
      input.addEventListener("focus", () => {
        state.activeSlotEl = input;
        updateLiveAstPreview(input.value);
      });
      input.addEventListener("input", () => {
        updateLiveAstPreview(input.value);
      });
    });

    // On-screen mobile keypad interactions
    document.querySelectorAll(".kp-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const target = state.activeSlotEl || els.ansSingle;
        if (!target) return;
        target.focus();

        const ins = btn.dataset.insert;
        const action = btn.dataset.action;
        const start = target.selectionStart ?? target.value.length;
        const end = target.selectionEnd ?? target.value.length;

        if (ins) {
          target.value = target.value.slice(0, start) + ins + target.value.slice(end);
          const newPos = start + ins.length;
          target.setSelectionRange(newPos, newPos);
        } else if (action === "backspace") {
          if (start !== end) {
            target.value = target.value.slice(0, start) + target.value.slice(end);
            target.setSelectionRange(start, start);
          } else if (start > 0) {
            target.value = target.value.slice(0, start - 1) + target.value.slice(end);
            target.setSelectionRange(start - 1, start - 1);
          }
        } else if (action === "clear") {
          target.value = "";
        }

        updateLiveAstPreview(target.value);
      });
    });

    // Global keyboard navigation (Enter to start / advance slots / submit)
    document.addEventListener("keydown", (e) => {
      if (!els.settingsModal.classList.contains("hidden")) {
        if (e.key === "Escape") closeSettingsModal();
        return;
      }

      if (e.key === "Enter") {
        e.preventDefault();
        if (state.status === "ready") {
          startRun();
          return;
        }
        if (state.status === "running" && state.currentQ) {
          const q = state.currentQ;
          if (q.inputType === "pair" && document.activeElement === els.ansPair1 && !els.ansPair2.value.trim()) {
            els.ansPair2.focus();
            return;
          }
          if (q.inputType === "matrix") {
            const idx = els.matSlots.indexOf(document.activeElement);
            if (idx >= 0 && idx < 3 && !els.matSlots[idx + 1].value.trim()) {
              els.matSlots[idx + 1].focus();
              return;
            }
          }
          submitAnswer();
        }
      }
    });

    // Header toggles & settings modal events
    document.getElementById("btn-sound").addEventListener("click", () => {
      state.settings.sound = !state.settings.sound;
      applyThemeAndKeypad();
      persistData();
    });

    document.getElementById("btn-theme").addEventListener("click", () => {
      state.settings.theme = state.settings.theme === "dark" ? "light" : "dark";
      applyThemeAndKeypad();
      persistData();
    });

    document.getElementById("btn-settings").addEventListener("click", openSettingsModal);
    document.getElementById("btn-ready-customise").addEventListener("click", openSettingsModal);
    document.getElementById("btn-close-settings").addEventListener("click", closeSettingsModal);

    // Quick preset buttons in Settings Modal
    document.querySelectorAll(".preset-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const preset = btn.dataset.preset;
        let ids = TOPICS.map(t => t.id);
        if (preset === "pure") {
          ids = TOPICS.filter(t => t.tier === "A-Level Pure").map(t => t.id);
        } else if (preset === "further") {
          ids = TOPICS.filter(t => t.tier === "Further Pure").map(t => t.id);
        } else if (preset === "quant") {
          ids = ["numerical", "quadratics", "matrices"];
        }
        els.topicTogglesGrid.querySelectorAll(".topic-chk").forEach(chk => {
          chk.checked = ids.includes(chk.value);
        });
        els.activeTopicCount.textContent = `${ids.length} / ${TOPICS.length} enabled`;
      });
    });

    document.getElementById("btn-reset-defaults").addEventListener("click", () => {
      state.settings = { ...DEFAULT_SETTINGS };
      persistData();
      applyThemeAndKeypad();
      openSettingsModal();
    });

    document.getElementById("btn-save-settings").addEventListener("click", () => {
      const checkedIds = Array.from(els.topicTogglesGrid.querySelectorAll(".topic-chk:checked")).map(c => c.value);
      state.settings.enabledTopics = checkedIds.length > 0 ? checkedIds : TOPICS.map(t => t.id);
      state.settings.difficulty = els.cfgDifficulty.value;
      state.settings.sprintSec = Number(els.cfgSprintSec.value) || 90;
      state.settings.deltaRule = els.cfgDeltaRule.value;
      state.settings.showKeypad = els.cfgShowKeypad.checked;
      state.settings.autoAdvance = els.cfgAutoAdvance.checked;

      persistData();
      applyThemeAndKeypad();
      closeSettingsModal();
      selectMode(state.mode);
    });

    // Boot application
    ensureKatex();
    applyThemeAndKeypad();
    selectMode("sprint");
  </script>
</body>
</html>
