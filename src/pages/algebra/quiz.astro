  <!-- Main Application Module integrating picocalc/nanoalgebra -->
  <script type="module">
    // =========================================================================
    // 1. NANOALGEBRA INTEGRATION & AST MATHEMATICAL VERIFIER
    // =========================================================================
    let nano = null;
    let nanoReady = false;

    const engineBadge = document.getElementById("engine-badge");

    try {
      const params = new URLSearchParams(window.location.search);
      const DEFAULT_COMMIT = 'a6b06f5';
      const commit = params.get('commit') || DEFAULT_COMMIT;
      if (commit?.length !== 7) throw new Error('Invalid `commit` param');
      const mod = await import(`https://esm.sh/gh/picocalc/nanoalgebra@${commit}`);
      if (mod && typeof mod.parse === "function" && typeof mod.simplify === "function") {
        nano = mod;
        engineBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>nanoalgebra@${commit}`;
        nanoReady = true;
      }
    } catch (err) {
      // Fallback parser/evaluator will activate automatically if CDN is unreachable
      nanoReady = false;
    }

    if (!nanoReady) {
      engineBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>exact-math fallback`;
    }

    // Configure nanoalgebra custom functions & constants (pi, e positive; i complex)
    const CUSTOM_FUNCTIONS = nanoReady
      ? new Set([
          ...nano.functions,
          "sin", "cos", "tan", "sec", "csc", "cosec", "cot", "ln", "log", "exp"
        ])
      : new Set(["abs", "sqrt", "sin", "cos", "tan", "sec", "csc", "cosec", "cot", "ln", "log", "exp"]);

    const CUSTOM_CONSTANTS = nanoReady
      ? (() => {
          const map = new Map(nano.constants);
          map.set("i", "complex");
          return map;
        })()
      : new Map([["pi", "positive"], ["e", "positive"], ["i", "complex"]]);

    /**
     * Parses and simplifies an input expression string using nanoalgebra.
     * Normalizes unicode math symbols (−, ×, ÷, π, √) before lexing.
     */
    function normalizeMathInput(raw) {
      return String(raw || "")
        .trim()
        .replace(/−/g, "-")
        .replace(/×/g, "*")
        .replace(/÷/g, "/")
        .replace(/π/g, "pi")
        .replace(/√\(/g, "sqrt(")
        .replace(/√([0-9a-zA-Z]+)/g, "sqrt($1)");
    }

    function nanoParseAndSimplify(rawExpr) {
      const expr = normalizeMathInput(rawExpr);
      if (!expr) throw new Error("Empty expression");

      if (nanoReady) {
        const parseOpts = { functions: CUSTOM_FUNCTIONS };
        const evalOpts = {
          functions: CUSTOM_FUNCTIONS,
          constants: CUSTOM_CONSTANTS,
          complex: true
        };
        const rawTree = nano.parse(expr, parseOpts);
        const simplifiedTree = nano.simplify(expr, evalOpts);
        return {
          rawTree,
          simplifiedTree,
          printed: simplifiedTree.print()
        };
      }

      return {
        rawTree: null,
        simplifiedTree: null,
        printed: expr
      };
    }

    /**
     * Converts a nanoalgebra TreeNode into crisp LaTeX for live KaTeX preview.
     */
    function treeToLatex(node, parentPrec = 0) {
      if (!node) return "";
      switch (node.type) {
        case "UNDEFINED":
          return "\\text{undefined}";
        case "INTEGER":
          return node.value.toString();
        case "DECIMAL":
          return node.print();
        case "FRACTION": {
          const num = node.numerator;
          const den = node.denominator;
          if (num < 0n) {
            return `-\\frac{${(-num).toString()}}{${den.toString()}}`;
          }
          return `\\frac{${num.toString()}}{${den.toString()}}`;
        }
        case "SYMBOL":
          if (node.name === "pi") return "\\pi";
          return node.name;
        case "FUNCTION": {
          const fn = node.name;
          const argsLatex = node.args.map(a => treeToLatex(a, 0));
          if (fn === "sqrt") return `\\sqrt{${argsLatex[0]}}`;
          if (fn === "abs") return `\\left|${argsLatex[0]}\\right|`;
          if (["sin", "cos", "tan", "sec", "csc", "cot", "ln", "log", "exp"].includes(fn)) {
            return `\\${fn === "csc" ? "operatorname{cosec}" : fn}\\left(${argsLatex.join(", ")}\\right)`;
          }
          return `\\operatorname{${fn}}\\left(${argsLatex.join(", ")}\\right)`;
        }
        case "ADD": {
          const s = `${treeToLatex(node.left, 1)} + ${treeToLatex(node.right, 1)}`;
          return parentPrec > 1 ? `\\left(${s}\\right)` : s;
        }
        case "SUBTRACT": {
          const s = `${treeToLatex(node.left, 1)} - ${treeToLatex(node.right, 2)}`;
          return parentPrec > 1 ? `\\left(${s}\\right)` : s;
        }
        case "MULTIPLY": {
          if (node.left.type === "INTEGER" && node.left.value === -1n) {
            return `-${treeToLatex(node.right, 3)}`;
          }
          const l = treeToLatex(node.left, 2);
          const r = treeToLatex(node.right, 2);
          const needsDot =
            (node.left.type === "INTEGER" || node.left.type === "FRACTION" || node.left.type === "DECIMAL") &&
            (node.right.type === "INTEGER" || node.right.type === "FRACTION" || node.right.type === "DECIMAL");
          const s = needsDot ? `${l} \\cdot ${r}` : `${l}${r}`;
          return parentPrec > 2 ? `\\left(${s}\\right)` : s;
        }
        case "DIVIDE": {
          return `\\frac{${treeToLatex(node.left, 0)}}{${treeToLatex(node.right, 0)}}`;
        }
        case "MOD": {
          return `${treeToLatex(node.left, 2)} \\bmod ${treeToLatex(node.right, 2)}`;
        }
        case "POWER": {
          const base = treeToLatex(node.left, 4);
          const exp = treeToLatex(node.right, 0);
          const needsParens = ["ADD", "SUBTRACT", "MULTIPLY", "DIVIDE", "FRACTION"].includes(node.left.type);
          const bStr = needsParens ? `\\left(${base}\\right)` : base;
          return `${bStr}^{${exp}}`;
        }
        default:
          return node.print ? node.print() : "";
      }
    }

    // Complex arithmetic helpers for exact AST numerical verification
    const C = {
      add: (a, b) => ({ re: a.re + b.re, im: a.im + b.im }),
      sub: (a, b) => ({ re: a.re - b.re, im: a.im - b.im }),
      mul: (a, b) => ({ re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re }),
      div: (a, b) => {
        const d = b.re * b.re + b.im * b.im;
        if (d === 0) throw new Error("Division by zero");
        return { re: (a.re * b.re + a.im * b.im) / d, im: (a.im * b.re - a.re * b.im) / d };
      },
      sqrt: (z) => {
        const r = Math.hypot(z.re, z.im);
        const re = Math.sqrt((r + z.re) / 2);
        const im = (z.im < 0 ? -1 : 1) * Math.sqrt(Math.max(0, (r - z.re) / 2));
        return { re, im };
      },
      exp: (z) => {
        const er = Math.exp(z.re);
        return { re: er * Math.cos(z.im), im: er * Math.sin(z.im) };
      },
      ln: (z) => {
        const r = Math.hypot(z.re, z.im);
        if (r === 0) throw new Error("ln(0) undefined");
        return { re: Math.log(r), im: Math.atan2(z.im, z.re) };
      },
      pow: (a, b) => {
        if (b.im === 0 && Number.isInteger(b.re)) {
          let n = b.re;
          if (n === 0) return { re: 1, im: 0 };
          let base = a;
          if (n < 0) {
            base = C.div({ re: 1, im: 0 }, a);
            n = -n;
          }
          let res = { re: 1, im: 0 };
          for (let k = 0; k < n; k++) res = C.mul(res, base);
          return res;
        }
        if (a.re === 0 && a.im === 0) return { re: 0, im: 0 };
        return C.exp(C.mul(b, C.ln(a)));
      },
      absDiff: (a, b) => Math.hypot(a.re - b.re, a.im - b.im)
    };

    /**
     * Evaluates a nanoalgebra TreeNode to a complex number {re, im} given variable bindings.
     */
    function evalTreeNode(node, env = {}) {
      if (!node) throw new Error("Empty AST");
      switch (node.type) {
        case "UNDEFINED":
          throw new Error("Undefined expression");
        case "INTEGER":
          return { re: Number(node.value), im: 0 };
        case "DECIMAL":
          return { re: Number(node.print()), im: 0 };
        case "FRACTION":
          return { re: Number(node.numerator) / Number(node.denominator), im: 0 };
        case "SYMBOL": {
          const name = node.name;
          if (name === "pi") return { re: Math.PI, im: 0 };
          if (name === "e") return { re: Math.E, im: 0 };
          if (name === "i") return { re: 0, im: 1 };
          if (Object.prototype.hasOwnProperty.call(env, name)) {
            const val = env[name];
            return typeof val === "number" ? { re: val, im: 0 } : val;
          }
          throw new Error(`Unknown variable '${name}'`);
        }
        case "ADD":
          return C.add(evalTreeNode(node.left, env), evalTreeNode(node.right, env));
        case "SUBTRACT":
          return C.sub(evalTreeNode(node.left, env), evalTreeNode(node.right, env));
        case "MULTIPLY":
          return C.mul(evalTreeNode(node.left, env), evalTreeNode(node.right, env));
        case "DIVIDE":
          return C.div(evalTreeNode(node.left, env), evalTreeNode(node.right, env));
        case "MOD": {
          const l = evalTreeNode(node.left, env);
          const r = evalTreeNode(node.right, env);
          if (l.im !== 0 || r.im !== 0) throw new Error("Modulo requires real values");
          return { re: ((l.re % r.re) + r.re) % r.re, im: 0 };
        }
        case "POWER":
          return C.pow(evalTreeNode(node.left, env), evalTreeNode(node.right, env));
        case "FUNCTION": {
          const fn = node.name;
          const arg0 = evalTreeNode(node.args[0], env);
          if (fn === "sqrt") return C.sqrt(arg0);
          if (fn === "abs") return { re: Math.hypot(arg0.re, arg0.im), im: 0 };
          if (fn === "exp") return C.exp(arg0);
          if (fn === "ln") return C.ln(arg0);
          if (fn === "log") {
            if (node.args.length === 2) {
              const base = evalTreeNode(node.args[1], env);
              return C.div(C.ln(arg0), C.ln(base));
            }
            return C.div(C.ln(arg0), { re: Math.LN10, im: 0 });
          }
          if (arg0.im !== 0) throw new Error(`Real argument expected for ${fn}`);
          const x = arg0.re;
          if (fn === "sin") return { re: Math.sin(x), im: 0 };
          if (fn === "cos") return { re: Math.cos(x), im: 0 };
          if (fn === "tan") return { re: Math.tan(x), im: 0 };
          if (fn === "sec") return { re: 1 / Math.cos(x), im: 0 };
          if (fn === "csc" || fn === "cosec") return { re: 1 / Math.sin(x), im: 0 };
          if (fn === "cot") return { re: 1 / Math.tan(x), im: 0 };
          throw new Error(`Unsupported function '${fn}'`);
        }
        default:
          throw new Error("Unsupported AST node");
      }
    }

    /**
     * Checks if a simplified AST contains a sqrt inside any denominator (used to enforce rationalised surds).
     */
    function hasSqrtInDenominator(node, inDenom = false) {
      if (!node) return false;
      if (node.type === "FUNCTION" && node.name === "sqrt" && inDenom) return true;
      if (node.type === "DIVIDE") {
        return hasSqrtInDenominator(node.left, inDenom) || hasSqrtInDenominator(node.right, true);
      }
      if (node.left && hasSqrtInDenominator(node.left, inDenom)) return true;
      if (node.right && hasSqrtInDenominator(node.right, inDenom)) return true;
      if (node.args) return node.args.some(a => hasSqrtInDenominator(a, inDenom));
      return false;
    }

    /**
     * Verifies if userExpr is mathematically equivalent to targetExpr via nanoalgebra.
     * Supports exact canonical difference check + multi-point symbolic probing.
     */
    function verifyExpression(userExpr, targetExpr, options = {}) {
      const { vars = [], requireRationalised = false } = options;
      const userParsed = nanoParseAndSimplify(userExpr);
      const targetParsed = nanoParseAndSimplify(targetExpr);

      if (!nanoReady) {
        const cleanU = normalizeMathInput(userExpr).replace(/\s+/g, "");
        const cleanT = normalizeMathInput(targetExpr).replace(/\s+/g, "");
        return { ok: cleanU === cleanT, diagnostic: null, printed: userParsed.printed };
      }

      if (requireRationalised && hasSqrtInDenominator(userParsed.simplifiedTree)) {
        return {
          ok: false,
          diagnostic: "Rationalise the denominator (no √ in denominator).",
          printed: userParsed.printed
        };
      }

      // 1. Direct canonical identity via nanoalgebra simplify((user) - (target)) === "0"
      try {
        const diffTree = nano.simplify(`(${normalizeMathInput(userExpr)}) - (${normalizeMathInput(targetExpr)})`, {
          functions: CUSTOM_FUNCTIONS,
          constants: CUSTOM_CONSTANTS,
          complex: true
        });
        if (diffTree.print() === "0") {
          return { ok: true, diagnostic: null, printed: userParsed.printed };
        }
      } catch (_) {
        // Proceed to multi-point AST verification
      }

      // 2. Exact AST numerical/complex verification across test points
      const samplePoints = vars.length === 0
        ? [{}]
        : [
            { x: 0.73, k: 1.41, t: 0.52 },
            { x: -1.37, k: -0.83, t: 1.91 },
            { x: 2.61, k: 3.17, t: -1.14 }
          ];

      for (const env of samplePoints) {
        const uVal = evalTreeNode(userParsed.simplifiedTree, env);
        const tVal = evalTreeNode(targetParsed.simplifiedTree, env);
        if (Number.isNaN(uVal.re) || Number.isNaN(uVal.im) || C.absDiff(uVal, tVal) > 1e-7) {
          return { ok: false, diagnostic: null, printed: userParsed.printed };
        }
      }

      return { ok: true, diagnostic: null, printed: userParsed.printed };
    }

    // =========================================================================
    // 2. PROCEDURAL YEAR 13 A-LEVEL PURE & FURTHER PURE GENERATORS
    // =========================================================================
    const randInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
    const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];
    const nonZeroInt = (min, max) => {
      let v = 0;
      while (v === 0) v = randInt(min, max);
      return v;
    };
    const gcd = (a, b) => {
      a = Math.abs(a); b = Math.abs(b);
      while (b) { [a, b] = [b, a % b]; }
      return a || 1;
    };
    const fmtFrac = (n, d) => {
      if (d < 0) { n = -n; d = -d; }
      const g = gcd(n, d);
      n /= g; d /= g;
      return d === 1 ? `${n}` : `${n}/${d}`;
    };
    const fmtSignedTerm = (coeff, variable = "", isFirst = false) => {
      if (coeff === 0) return "";
      const absC = Math.abs(coeff);
      const sign = coeff < 0 ? (isFirst ? "-" : " - ") : (isFirst ? "" : " + ");
      const numStr = (absC === 1 && variable) ? "" : `${absC}`;
      return `${sign}${numStr}${variable}`;
    };

    const TOPICS = [
      { id: "numerical", name: "Rapid Numerical", tier: "Quant / Speed", desc: "Products, squares, exact fractions & modular arithmetic" },
