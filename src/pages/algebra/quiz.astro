            answer: [item.r, item.theta],
            numericCarry: 2,
            solutionLatex: `|z| = ${item.r.replace(/sqrt\(([^)]+)\)/g, "\\sqrt{$1}")}, \\quad \\arg(z) = ${item.theta.replace("pi", "\\pi")} \\in (-\\pi, \\pi]`,
            checkTrap: ([, uTheta]) => {
              try {
                if (verifyExpression(uTheta, item.trapTheta).ok) {
                  return "Principal argument trap: check Argand quadrant and ensure θ ∈ (-π, π]!";
                }
              } catch (_) {}
              return null;
            }
          };
        }

        case "matrices": {
          const variant = chainVal !== null ? 0 : randInt(0, 2);
          if (variant === 0) {
            const a = chainVal !== null ? (chainVal % 6 || 3) : nonZeroInt(-5, 6);
            const b = nonZeroInt(-5, 5);
            const c = nonZeroInt(-5, 5);
            const d = nonZeroInt(-5, 6);
            const det = a * d - b * c;
            return {
              topicId, tier: "Further Pure", topicName: "2×2 Matrices",
              instruction: "Evaluate the determinant det(M):",
              latex: `M = \\begin{pmatrix} ${a} & ${b} \\\\ ${c} & ${d} \\end{pmatrix}`,
              formatHint: "ad - bc",
              inputType: "single",
              answer: `${det}`,
              numericCarry: det,
              solutionLatex: `\\det(M) = (${a})(${d}) - (${b})(${c}) = ${a * d} - (${b * c}) = ${det}`
            };
          }
          if (variant === 1) {
            const c = pick([2, 3, -2, -3]);
            const d = nonZeroInt(-4, 5);
            const m = nonZeroInt(-3, 4);
            const aVal = m * c;
            const kTarget = m * d;
            return {
              topicId, tier: "Further Pure", topicName: "2×2 Matrices",
              instruction: "Find k given that M is singular (non-invertible):",
              latex: `M = \\begin{pmatrix} ${aVal} & k \\\\ ${c} & ${d} \\end{pmatrix}`,
              formatHint: "Set det(M) = 0",
              inputType: "single",
              answer: `${kTarget}`,
              numericCarry: kTarget,
              solutionLatex: `${aVal}(${d}) - ${c}k = 0 \\implies ${c}k = ${aVal * d} \\implies k = ${kTarget}`
            };
          }
          const templates = [
            { a: 3, b: 2, c: 1, d: 1 },
            { a: 2, b: 3, c: 1, d: 2 },
            { a: 4, b: 3, c: 3, d: 2 },
            { a: 3, b: 4, c: 1, d: 2 },
            { a: 4, b: 1, c: 2, d: 1 },
            { a: 1, b: 3, c: 1, d: 1 }
          ];
          const t = pick(templates);
          const det = t.a * t.d - t.b * t.c;
          const inv = [
            fmtFrac(t.d, det),
            fmtFrac(-t.b, det),
            fmtFrac(-t.c, det),
            fmtFrac(t.a, det)
          ];
          return {
            topicId, tier: "Further Pure", topicName: "2×2 Matrices",
            instruction: "Find the inverse matrix M⁻¹:",
            latex: `M = \\begin{pmatrix} ${t.a} & ${t.b} \\\\ ${t.c} & ${t.d} \\end{pmatrix}`,
            formatHint: "Enter exact entries (e.g. -3/2)",
            inputType: "matrix",
            answer: inv,
            numericCarry: det,
            solutionLatex: `\\det(M) = ${det}, \\quad M^{-1} = \\frac{1}{${det}}\\begin{pmatrix} ${t.d} & ${-t.b} \\\\ ${-t.c} & ${t.a} \\end{pmatrix} = \\begin{pmatrix} ${inv[0]} & ${inv[1]} \\\\ ${inv[2]} & ${inv[3]} \\end{pmatrix}`,
            checkTrap: (uArr) => {
              if (uArr[1] === fmtFrac(t.b, det) || uArr[2] === fmtFrac(t.c, det)) {
                return "Matrix inverse trap: swap main diagonal (a, d) and NEGATE off-diagonal (-b, -c)!";
              }
              return null;
            }
          };
        }

        case "roots_poly":
        default: {
          const a = easy ? 1 : pick([1, 2]);
          const sumAlpha = nonZeroInt(-5, 5);
          const sumPair = nonZeroInt(-6, 6);
          const prodAlpha = nonZeroInt(-6, 6);
          const b = -a * sumAlpha;
          const c = a * sumPair;
          const d = -a * prodAlpha;
          const polyLatex = `${fmtSignedTerm(a, "x^3", true)}${fmtSignedTerm(b, "x^2", false)}${fmtSignedTerm(c, "x", false)}${fmtSignedTerm(d, "", false)} = 0`;

          const askType = pick(["sum", "pair", "prod", "sumSq"]);
          if (askType === "sum") {
            return {
              topicId: "roots_poly", tier: "Further Pure", topicName: "Roots of Polynomials",
              instruction: "Roots are α, β, γ. Find α + β + γ:",
              latex: polyLatex,
              formatHint: "Vieta: -b/a",
              inputType: "single",
              answer: `${sumAlpha}`,
              numericCarry: sumAlpha,
              solutionLatex: `\\sum \\alpha = -\\frac{b}{a} = -\\frac{${b}}{${a}} = ${sumAlpha}`,
              checkTrap: ([u]) => u === `${-sumAlpha}` ? "Vieta sign trap: Σα = -b/a (flip the sign of b)!" : null
            };
          }
          if (askType === "prod") {
            return {
              topicId: "roots_poly", tier: "Further Pure", topicName: "Roots of Polynomials",
              instruction: "Roots are α, β, γ. Find αβγ:",
              latex: polyLatex,
              formatHint: "Vieta: -d/a",
              inputType: "single",
              answer: `${prodAlpha}`,
              numericCarry: prodAlpha,
              solutionLatex: `\\alpha\\beta\\gamma = -\\frac{d}{a} = -\\frac{${d}}{${a}} = ${prodAlpha}`,
              checkTrap: ([u]) => u === `${-prodAlpha}` ? "Vieta sign trap: for a cubic, αβγ = -d/a!" : null
            };
          }
          const sumSq = sumAlpha * sumAlpha - 2 * sumPair;
          return {
            topicId: "roots_poly", tier: "Further Pure", topicName: "Roots of Polynomials",
            instruction: "Roots are α, β, γ. Find α² + β² + γ²:",
            latex: polyLatex,
            formatHint: "Use (Σα)² - 2(Σαβ)",
            inputType: "single",
            answer: `${sumSq}`,
            numericCarry: sumSq,
            solutionLatex: `\\sum \\alpha^2 = (\\sum \\alpha)^2 - 2\\sum \\alpha\\beta = (${sumAlpha})^2 - 2(${sumPair}) = ${sumSq}`
          };
        }
      }
    }

    // =========================================================================
    // 3. WEB AUDIO SYNTH FEEDBACK (ZERO EXTERNAL URLS)
    // =========================================================================
    let audioCtx = null;
    function playTone(type) {
      if (!state.settings.sound) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === "suspended") audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        const now = audioCtx.currentTime;

        if (type === "hit") {
          osc.type = "sine";
          osc.frequency.setValueAtTime(523.25, now);
          osc.frequency.exponentialRampToValueAtTime(783.99, now + 0.09);
          gain.gain.setValueAtTime(0.08, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
          osc.start(now);
          osc.stop(now + 0.15);
        } else if (type === "miss") {
          osc.type = "triangle";
          osc.frequency.setValueAtTime(190, now);
          osc.frequency.linearRampToValueAtTime(135, now + 0.16);
          gain.gain.setValueAtTime(0.09, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
          osc.start(now);
          osc.stop(now + 0.19);
        } else if (type === "complete") {
          osc.type = "sine";
          osc.frequency.setValueAtTime(587.33, now);
          osc.frequency.setValueAtTime(880, now + 0.1);
          gain.gain.setValueAtTime(0.09, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
          osc.start(now);
          osc.stop(now + 0.3);
        }
      } catch (_) {}
    }

    // =========================================================================
    // 4. APPLICATION STATE & PERSISTENCE
    // =========================================================================
    const DEFAULT_SETTINGS = {
      enabledTopics: TOPICS.map(t => t.id),
      difficulty: "exam",
      sprintSec: 90,
      deltaRule: "4,-8",
      showKeypad: true,
      autoAdvance: true,
      sound: true,
      theme: "dark"
    };

    const STORAGE_KEY = "y13_fm_speed_studio_v1";
    function loadSavedData() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return { settings: { ...DEFAULT_SETTINGS }, bests: {} };
        const parsed = JSON.parse(raw);
        return {
          settings: { ...DEFAULT_SETTINGS, ...(parsed.settings || {}) },
          bests: parsed.bests || {}
        };
      } catch (_) {
        return { settings: { ...DEFAULT_SETTINGS }, bests: {} };
      }
    }

    const saved = loadSavedData();
    function persistData() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          settings: state.settings,
          bests: state.bests
        }));
      } catch (_) {}
    }

    const state = {
      mode: "sprint", // "sprint" | "timedelta" | "pipeline" | "zen"
      status: "ready", // "ready" | "running" | "summary"
      settings: saved.settings,
      bests: saved.bests,
      timeLeft: 90,
      elapsed: 0,
      solved: 0,
      attempts: 0,
      streak: 0,
      bestStreak: 0,
      topicStats: {},
      pipelineStage: 1,
      pipelineCarry: null,
      pipelinesCompleted: 0,
      currentQ: null,
      qStartTime: 0,
      activeSlotEl: null,
      timerHandle: null
    };

    // =========================================================================
