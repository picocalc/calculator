<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>A-Level & FM Speed Studio • NanoAlgebra</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.jsdelivr.net/npm/tailwindcss-cdn@3.4.10/tailwindcss.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['JetBrains Mono', 'ui-monospace', 'SFMono-Regular', 'monospace'],
          },
          colors: {
            brand: {
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
            },
            accent: {
              400: '#a78bfa',
              500: '#8b5cf6',
              600: '#7c3aed',
            }
          }
        }
      }
    };
  </script>

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- KaTeX for publication-grade math rendering (with multi-CDN fallback for local exports) -->
  <link id="katex-css" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    onerror="this.onerror=null;this.href='https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.css';" />
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"
    onerror="this.onerror=null;this.src='https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.js';"></script>

  <style>
    /* Smooth custom scrollbars & mobile tap ergonomics */
    * {
      -webkit-tap-highlight-color: transparent;
    }
    html, body {
      overscroll-behavior-y: contain;
    }
    .katex-display {
      margin: 0.35em 0 !important;
      overflow-x: auto;
      overflow-y: hidden;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-6px); }
      40% { transform: translateX(6px); }
      60% { transform: translateX(-4px); }
      80% { transform: translateX(4px); }
    }
    .animate-shake {
      animation: shake 0.32s ease-in-out;
    }
    @keyframes popIn {
      0% { transform: scale(0.96); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes floatDelta {
      0% { transform: translateY(0); opacity: 1; }
      100% { transform: translateY(-22px); opacity: 0; }
    }
    .animate-delta {
      animation: floatDelta 0.85s ease-out forwards;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 font-sans min-h-[100dvh] flex flex-col selection:bg-sky-500/30">

  <!-- Top Navigation & Engine Status Bar -->
  <header class="sticky top-0 z-30 backdrop-blur-md bg-white/85 dark:bg-slate-950/85 border-b border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-5xl mx-auto px-3 sm:px-6 h-14 flex items-center justify-between gap-2">
      <!-- Brand + NanoAlgebra Badge -->
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-500 to-violet-600 flex items-center justify-center text-white font-mono font-bold text-lg shadow-sm shrink-0">
          ∑
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <h1 class="font-bold text-sm sm:text-base tracking-tight truncate">Y13 Math & FM Sprint</h1>
            <span id="engine-badge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-mono font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              nanoalgebra
            </span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 hidden sm:block truncate">
            Rapid Numerical + A-Level Pure & Further Pure Fluency
          </p>
        </div>
      </div>

      <!-- Right Action Controls -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Sound Toggle -->
        <button id="btn-sound" type="button" title="Toggle Synth Feedback"
          class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100/70 dark:bg-slate-900/70 hover:bg-slate-200/70 dark:hover:bg-slate-800 transition text-slate-600 dark:text-slate-300">
          <svg id="icon-sound-on" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5zM15.54 8.46a5 5 0 010 7.07M19.07 4.93a10 10 0 010 14.14"/>
          </svg>
          <svg id="icon-sound-off" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5zM23 9l-6 6M17 9l6 6"/>
          </svg>
        </button>

        <!-- Theme Toggle -->
        <button id="btn-theme" type="button" title="Toggle Light/Dark Theme"
          class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100/70 dark:bg-slate-900/70 hover:bg-slate-200/70 dark:hover:bg-slate-800 transition text-slate-600 dark:text-slate-300">
          <svg id="icon-sun" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
          <svg id="icon-moon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
          </svg>
        </button>

        <!-- Customise Syllabus & Rules Button -->
        <button id="btn-settings" type="button"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 hover:opacity-90 transition shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
          </svg>
          <span>Customise</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="flex-1 max-w-5xl w-full mx-auto px-3 sm:px-6 py-4 sm:py-6 flex flex-col gap-4">

    <!-- 4-Mode Segmented Toggle Bar -->
    <section aria-label="Drill Mode Selector" class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-2xl p-1.5 shadow-sm">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5" id="mode-toggle-group">
        <button type="button" data-mode="sprint"
          class="mode-btn flex flex-col items-start sm:items-center justify-center px-3 py-2.5 rounded-xl text-left sm:text-center transition font-medium">
          <span class="text-xs sm:text-sm font-bold flex items-center gap-1.5">
            <span>⚡ Timed Sprint</span>
          </span>
          <span class="text-[11px] opacity-75">Fixed clock blitz</span>
        </button>

        <button type="button" data-mode="timedelta"
          class="mode-btn flex flex-col items-start sm:items-center justify-center px-3 py-2.5 rounded-xl text-left sm:text-center transition font-medium">
          <span class="text-xs sm:text-sm font-bold flex items-center gap-1.5">
            <span>⏱️ Time-Delta</span>
          </span>
          <span class="text-[11px] opacity-75">+4s hit / -8s miss</span>
        </button>

        <button type="button" data-mode="pipeline"
          class="mode-btn flex flex-col items-start sm:items-center justify-center px-3 py-2.5 rounded-xl text-left sm:text-center transition font-medium">
          <span class="text-xs sm:text-sm font-bold flex items-center gap-1.5">
            <span>🔗 Chain Pipeline</span>
          </span>
          <span class="text-[11px] opacity-75">3-step exam flow</span>
        </button>

        <button type="button" data-mode="zen"
          class="mode-btn flex flex-col items-start sm:items-center justify-center px-3 py-2.5 rounded-xl text-left sm:text-center transition font-medium">
          <span class="text-xs sm:text-sm font-bold flex items-center gap-1.5">
            <span>🎯 Zen Practice</span>
          </span>
          <span class="text-[11px] opacity-75">Untimed + solutions</span>
        </button>
      </div>
    </section>

    <!-- Live Telemetry HUD -->
    <section class="grid grid-cols-4 gap-2 sm:gap-3">
      <!-- Timer / Stopwatch -->
      <div class="relative bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-4 flex flex-col justify-between">
        <span id="hud-timer-label" class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Time Left</span>
        <div class="flex items-baseline gap-1.5 mt-1">
          <span id="hud-timer" class="font-mono text-xl sm:text-2xl font-bold text-sky-600 dark:text-sky-400">90.0s</span>
          <span id="hud-delta-pop" class="font-mono text-xs font-bold pointer-events-none"></span>
        </div>
      </div>

      <!-- Score / Solved -->
      <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-4 flex flex-col justify-between">
        <span class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Solved</span>
        <div class="flex items-baseline gap-2 mt-1">
          <span id="hud-solved" class="font-mono text-xl sm:text-2xl font-bold">0</span>
          <span id="hud-spm" class="text-xs font-mono text-slate-400 hidden sm:inline">0.0/m</span>
        </div>
      </div>

      <!-- Streak & Multiplier -->
      <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-4 flex flex-col justify-between">
        <span class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Streak</span>
        <div class="flex items-baseline gap-1.5 mt-1">
          <span id="hud-streak" class="font-mono text-xl sm:text-2xl font-bold text-amber-500">0</span>
          <span id="hud-mult" class="text-xs font-mono font-semibold text-amber-500/80">1×</span>
        </div>
      </div>

      <!-- Accuracy -->
      <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-4 flex flex-col justify-between">
        <span class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Accuracy</span>
        <div class="flex items-baseline gap-1.5 mt-1">
          <span id="hud-accuracy" class="font-mono text-xl sm:text-2xl font-bold text-emerald-600 dark:text-emerald-400">100%</span>
        </div>
      </div>
    </section>

    <!-- Active Drill Stage Card -->
    <section id="drill-card" class="relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-4 sm:p-7 shadow-sm flex-1 flex flex-col justify-between transition-colors">

      <!-- Ready / Start Overlay (shown before timed runs start) -->
      <div id="start-overlay" class="hidden flex-1 flex flex-col items-center justify-center text-center py-6 px-2 gap-5 animate-pop">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
          <span id="ready-preset-label">Year 13 Full Mix • 8 Topics Active</span>
        </div>
        <div class="max-w-lg space-y-2">
          <h2 id="ready-mode-title" class="text-2xl sm:text-3xl font-extrabold tracking-tight">Timed Sprint (90s)</h2>
          <p id="ready-mode-desc" class="text-sm sm:text-base text-slate-500 dark:text-slate-400">
            High-velocity rapid arithmetic blended with A-Level Pure and Further Pure micro-drills. Exact fractions, surds, and complex expressions validated via <code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800">nanoalgebra</code>.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <button id="btn-start-run" type="button"
            class="px-7 py-3.5 rounded-2xl font-bold text-base bg-gradient-to-r from-sky-500 to-violet-600 text-white shadow-lg shadow-sky-500/20 hover:opacity-95 active:scale-[0.99] transition">
            Start Drill (Enter)
          </button>
          <button id="btn-ready-customise" type="button"
            class="px-5 py-3.5 rounded-2xl font-semibold text-sm border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
            Configure Topics
          </button>
        </div>
        <div id="ready-pb-badge" class="text-xs font-mono text-slate-400">
          Personal Best: —
        </div>
      </div>

      <!-- Post-Run Analytics Summary Overlay -->
      <div id="summary-overlay" class="hidden flex-1 flex flex-col justify-between gap-5 py-2 animate-pop">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-violet-500">Session Complete</span>
            <h2 id="summary-title" class="text-2xl font-extrabold mt-0.5">Sprint Debrief</h2>
            <p id="summary-subtitle" class="text-xs font-mono text-slate-400 mt-1"></p>
          </div>
          <div class="flex items-center gap-2">
            <button id="btn-drill-weakest" type="button"
              class="hidden px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30 hover:bg-amber-500/25 transition">
              Drill Weakest Topic
            </button>
            <button id="btn-restart-run" type="button"
              class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-sky-500 text-white hover:bg-sky-600 transition shadow-sm">
              Run Again
            </button>
          </div>
        </div>

        <!-- Core Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs text-slate-400">Total Solved</div>
            <div id="sum-solved" class="font-mono text-2xl font-bold mt-1">0</div>
          </div>
          <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs text-slate-400">Speed (SPM)</div>
            <div id="sum-spm" class="font-mono text-2xl font-bold text-sky-500 mt-1">0.0</div>
          </div>
          <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs text-slate-400">Accuracy</div>
            <div id="sum-acc" class="font-mono text-2xl font-bold text-emerald-500 mt-1">100%</div>
          </div>
          <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs text-slate-400">Best Streak</div>
            <div id="sum-streak" class="font-mono text-2xl font-bold text-amber-500 mt-1">0</div>
          </div>
        </div>

        <!-- Topic Breakdown Table -->
        <div class="space-y-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Topic Telemetry</h3>
          <div id="sum-topic-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-52 overflow-y-auto pr-1">
            <!-- Populated dynamically -->
          </div>
        </div>
      </div>

      <!-- Active Question Workspace -->
      <div id="question-workspace" class="flex-1 flex flex-col justify-between gap-4">
        <!-- Top Meta Row: Syllabus Tag + Pipeline Progress + Actions -->
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="q-tier-badge" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-violet-500/10 text-violet-600 dark:text-violet-400 border border-violet-500/20">
              A-Level Pure
            </span>
            <span id="q-topic-badge" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              Quadratics
            </span>
            <span id="q-step-timer" class="font-mono text-xs text-slate-400">0.0s</span>
          </div>

          <!-- Chain Pipeline 3-Step Indicator (visible in Pipeline mode) -->
          <div id="pipeline-tracker" class="hidden items-center gap-1.5 bg-slate-100 dark:bg-slate-800/80 px-3 py-1.5 rounded-xl">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 mr-1">CHAIN:</span>
            <span id="pipe-step-1" class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-sky-500 text-white">1</span>
            <span class="text-slate-400 text-xs">→</span>
            <span id="pipe-step-2" class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-slate-200 dark:bg-slate-700 text-slate-500">2</span>
            <span class="text-slate-400 text-xs">→</span>
            <span id="pipe-step-3" class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-slate-200 dark:bg-slate-700 text-slate-500">3</span>
            <span id="pipe-carry-badge" class="hidden ml-1.5 px-2 py-0.5 rounded-md text-xs font-mono bg-amber-500/15 text-amber-600 dark:text-amber-300 border border-amber-500/30"></span>
          </div>

          <!-- Quick Question Controls -->
          <div class="flex items-center gap-1.5">
            <button id="btn-show-solution" type="button"
              class="px-3 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
              Method / Hint
            </button>
            <button id="btn-skip-question" type="button"
              class="px-3 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
              Skip
            </button>
            <button id="btn-finish-session" type="button"
              class="px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/25 transition">
              Finish
            </button>
          </div>
        </div>

        <!-- Prompt Display Box -->
        <div class="my-auto py-3 sm:py-5 px-3 sm:px-6 rounded-2xl bg-slate-50/90 dark:bg-slate-950/60 border border-slate-200/70 dark:border-slate-800/80 text-center flex flex-col items-center justify-center min-h-[135px] sm:min-h-[160px]">
          <p id="q-instruction" class="text-xs sm:text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">
            Evaluate mentally:
          </p>
          <div id="q-math-display" class="text-xl sm:text-3xl font-semibold text-slate-900 dark:text-white max-w-full overflow-x-auto py-1">
            <!-- KaTeX equation renders here -->
          </div>
          <p id="q-format-hint" class="text-[11px] font-mono text-slate-400 mt-2">
            Enter exact simplified expression
          </p>
        </div>

        <!-- Answer Input Area (Supports Single Slot, Pair Slots, and 2x2 Matrix Slots) -->
        <div class="space-y-3">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
            <!-- Mode A: Single Expression Input -->
            <div id="input-mode-single" class="flex-1">
              <input id="ans-single" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                placeholder="Type exact answer (e.g. -3/4, 2sqrt(3), 5 - 2i)..."
                class="math-slot w-full px-4 py-3.5 rounded-2xl font-mono text-base sm:text-lg bg-slate-50 dark:bg-slate-950 border-2 border-slate-200 dark:border-slate-800 focus:border-sky-500 dark:focus:border-sky-400 focus:outline-none transition" />
            </div>

            <!-- Mode B: Two-Slot Pair Input (e.g. Partial Fractions A & B, Complex r & theta, Completed Square p & q) -->
            <div id="input-mode-pair" class="hidden flex-1 grid grid-cols-2 gap-2.5">
              <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-950 border-2 border-slate-200 dark:border-slate-800 focus-within:border-sky-500 rounded-2xl px-3 py-2">
                <span id="pair-label-1" class="font-mono text-sm font-bold text-slate-400 shrink-0">A =</span>
                <input id="ans-pair-1" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                  placeholder="Slot 1"
                  class="math-slot w-full bg-transparent font-mono text-base sm:text-lg focus:outline-none" />
              </div>
              <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-950 border-2 border-slate-200 dark:border-slate-800 focus-within:border-sky-500 rounded-2xl px-3 py-2">
                <span id="pair-label-2" class="font-mono text-sm font-bold text-slate-400 shrink-0">B =</span>
                <input id="ans-pair-2" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                  placeholder="Slot 2"
                  class="math-slot w-full bg-transparent font-mono text-base sm:text-lg focus:outline-none" />
              </div>
            </div>

            <!-- Mode C: 2x2 Matrix Grid Input -->
            <div id="input-mode-matrix" class="hidden flex-1 flex items-center justify-center">
              <div class="inline-flex items-center gap-2 px-3 py-2 rounded-2xl bg-slate-50 dark:bg-slate-950 border-2 border-slate-200 dark:border-slate-800">
                <span class="text-3xl font-light text-slate-400 select-none">(</span>
                <div class="grid grid-cols-2 gap-2">
